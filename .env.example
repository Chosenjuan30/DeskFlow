# ─────────────────────────────────────────────────────────────
# DeskFlow — Environment Variables
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Spring profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/deskflow
DATABASE_USERNAME=deskflow
DATABASE_PASSWORD=deskflow_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Mail (MailHog for dev, real SMTP for prod)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT — CHANGE THIS in production! Must be ≥ 256 bits (32+ chars).
JWT_SECRET=deskflow-secret-key-at-least-256-bits-change-in-prod-1234567890abcdef
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# CORS — comma-separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws