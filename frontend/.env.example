# DeskFlow Frontend — Environment Variables
# Copy to .env.local for local development

# Backend API base URL (empty = use Vite proxy in dev)
VITE_API_BASE_URL=

# WebSocket URL (empty = use Vite proxy in dev)
VITE_WS_URL=

# For production builds, set real values:
# VITE_API_BASE_URL=https://api.deskflow.io
# VITE_WS_URL=https://api.deskflow.io/ws